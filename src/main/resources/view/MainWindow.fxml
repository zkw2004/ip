<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.7"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="friday.MainWindow"
            prefWidth="400.0"
            prefHeight="600.0">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="56.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0" />
            </content>
        </ScrollPane>
        <HBox spacing="8.0"
              AnchorPane.leftAnchor="8.0"
              AnchorPane.rightAnchor="8.0"
              AnchorPane.bottomAnchor="8.0">
            <children>
                <TextField fx:id="userInput"
                           promptText="Enter a command"
                           onAction="#handleUserInput"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#handleUserInput" />
            </children>
        </HBox>
    </children>
</AnchorPane>
